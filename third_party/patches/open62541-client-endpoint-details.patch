+    switch(mode) {
+        case UA_MESSAGESECURITYMODE_NONE: return "None";
+        case UA_MESSAGESECURITYMODE_SIGN: return "Sign";
+        case UA_MESSAGESECURITYMODE_SIGNANDENCRYPT: return "SignAndEncrypt";
+        default: return "Invalid";
+    }
+}
